# Environment Variables for Pizza MCP Project

# Groq API Key (Get from: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Google API Key (Get from: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# Backend Configuration
BACKEND_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# MCP Server Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=3000

# Database
DATABASE_PATH=backend/pizza.db

# Agent Configuration (ALL REQUIRED - NO FALLBACKS)
ORDERING_AGENT_NAME=Pizza Ordering Assistant
ORDERING_AGENT_TEMPERATURE=0.1
SCHEDULING_AGENT_NAME=Pizza Scheduling Assistant
SCHEDULING_AGENT_TEMPERATURE=0.1
GROQ_MODEL_ID=llama-3.1-8b-instant
GEMINI_MODEL_ID=gemini-3-flash-preview
AGENT_TEMPERATURE=0.1
DEFAULT_DELIVERY_WINDOW_MINUTES=30
DEFAULT_PREP_BUFFER_MINUTES=5

# External MCP Services
EXTERNAL_SERVICE_TIMEOUT=10
EXTERNAL_SERVICE_RETRIES=3

# Timezone Configuration
TIMEZONE=Asia/Kolkata
TIME_FORMAT=12_hour
DISPLAY_TIMEZONE_SUFFIX=IST

# Logging
LOG_LEVEL=INFO

# Email Configuration (Optional - for notifications)
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
